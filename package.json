{
  "name": "@jp-design-system/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx run-many -t build --parallel=3",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "nx run-many -t lint --parallel=3 && npm run lint:colors && npm run lint:primitives && npm run tokens:check",
    "lint:colors": "node tools/check-no-hardcoded-colors.mjs",
    "lint:primitives": "node tools/check-no-primitive-token-usage.mjs",
    "tokens:build": "nx run tokens:build-tokens",
    "tokens:check": "nx run tokens:check-tokens",
    "test": "nx run-many -t test --parallel=2 --codeCoverage=true",
    "typecheck": "nx run-many -t typecheck",
    "packages:build": "nx run packages:build",
    "packages:smoke": "nx run packages:smoke"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
