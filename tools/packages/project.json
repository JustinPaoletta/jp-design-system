{
  "name": "packages",
  "projectType": "library",
  "root": "tools/packages",
  "targets": {
    "check-release": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tools/release/**/*",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/libs/ui/package.json",
        "{workspaceRoot}/libs/tokens/package.distribution.json",
        "{workspaceRoot}/CHANGELOG.md"
      ],
      "options": {
        "command": "node --test tools/release/prepare.spec.mjs"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["tokens:build-tokens"],
      "outputs": ["{workspaceRoot}/dist/packages"],
      "options": {
        "command": "node tools/build-packages.mjs"
      }
    },
    "smoke": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "command": "node tools/consumer-smoke.mjs"
      }
    }
  }
}
